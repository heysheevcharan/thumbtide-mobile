# Cascade: the phone controller and the game's pace.
# Syntax and every setting: web/src/games/kit/pad.ts
# Mobile: every phone shows the board; on your turn, tap a cell to drop a piece there.

controller
  orientation  portrait

button place
  label        "Tap a cell"
  hint         "On your turn, tap an empty cell or one of yours to add a piece. A full cell bursts into its neighbours and takes them over. Last colour standing wins."
  icon         action
  style        primary
  haptic       22ms

buzz                         # ms on, off, on…
  turn         40 60 40      # your turn
  nope         12 40 12      # that cell isn't yours
  wait         8             # tapped on someone else's turn
  out          250
  win          40 40 40 40 120
  lose         300

tune
  bot-think    900           # ms a computer looks at the board before it moves
  away-wait    3000          # ms before the computer plays for someone whose phone dropped
  away-skip    20000         # turn timer off: ms before the turn of someone whose phone is on another app passes on
